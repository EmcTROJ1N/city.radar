# Скопируйте в .env: cp .env.example .env
# Файл .env в git не попадает (.gitignore). Реальные секреты сюда не коммитятся.

# ---- База и кэш (dev и prod) ------------------------------------------------------------
POSTGRES_USER=mayak
POSTGRES_PASSWORD=mayak_dev
POSTGRES_DB=mayak
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- Production-развёртывание (deploy/docker-compose.prod.yml) --------------------------
# Порты reverse-proxy НА ХОСТЕ. 80/443 занимают другие сервисы — по умолчанию нестандартные.
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443

# Тег образов Api/Worker/proxy. Обновляйте вместе с пересборкой.
MAYAK_IMAGE_TAG=local

# Пути к файлам Docker secrets на хосте (относительно каталога deploy/).
# Создание: см. docs/runbook-backend.md, раздел «Первый запуск».
MAYAK_MASTER_KEY_PATH=./secrets/mayak_master_key
JWT_SIGNING_KEY_PATH=./secrets/jwt_signing_key

# Ротация мастер-ключа (обычно 1; после ротации — 2, 3, …).
MAYAK_MASTER_KEY_VERSION=1
# Предыдущий ключ — только на время ротации (docker-compose.rotate.yml).
MAYAK_MASTER_KEY_PREV_PATH=./secrets/mayak_master_key_prev

# JWT (ключ подписи — только файлом-секретом, не переменной).
JWT_ISSUER=mayak
JWT_AUDIENCE=mayak
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Worker: период опроса настроек источников, секунды.
WORKER_CONFIG_POLL_SECONDS=10

# Бэкапы: интервал и срок хранения (— 14 дней).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
