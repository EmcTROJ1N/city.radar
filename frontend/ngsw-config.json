{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/favicon.ico",
          "/favicon.svg",
          "/icon.svg",
          "/icons/**"
        ]
      }
    },
    {
      "name": "lazy-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "map-features",
      "urls": ["/api/v1/map/features**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "catalog",
      "urls": [
        "/api/v1/catalog/categories**",
        "/api/v1/catalog/groups**",
        "/api/v1/catalog/statuses**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "1d",
        "timeout": "5s"
      }
    }
  ]
}
