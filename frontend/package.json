{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "types": "npm --prefix ../api run types",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "steiger ./src",
    "map-style": "node scripts/build-map-style.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "verify": "npm run typecheck && tsc --noEmit -p tsconfig.spec.json && npm run test:scripts && ng build && ng test --watch=false && npm run lint"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.26",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "maplibre-gl": "^5.24.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "steiger": "^0.6.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
